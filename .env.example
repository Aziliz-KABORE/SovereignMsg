# ==============================================================================
# SovereignMsg - Modèle de variables d'environnement (.env.example)
# ATTENTION : Ne JAMAIS commiter de fichier .env réel ni aucun secret.
# Copiez ce fichier vers .env et remplacez les valeurs de démonstration ci-dessous.
# ==============================================================================

# --- Environnement global ---
ENVIRONMENT=demonstration
DOMAIN_NAME=localhost
HTTPS_PORT=443

# --- Base de données PostgreSQL pour Synapse (Instance 1) ---
# Encodage UTF-8 et collation C obligatoires pour Synapse
POSTGRES_SYNAPSE_DB=synapse
POSTGRES_SYNAPSE_USER=synapse_user
POSTGRES_SYNAPSE_PASSWORD=CHANGEME_SYNAPSE_DB_PASSWORD_MIN32CHARS
POSTGRES_SYNAPSE_HOST=postgres-synapse
POSTGRES_SYNAPSE_PORT=5432

# --- Base de données PostgreSQL pour la Passerelle d'Identité (Instance 2) ---
POSTGRES_GATEWAY_DB=gateway_db
POSTGRES_GATEWAY_USER=gateway_user
POSTGRES_GATEWAY_PASSWORD=CHANGEME_GATEWAY_DB_PASSWORD_MIN32CHARS
POSTGRES_GATEWAY_HOST=postgres-gateway
POSTGRES_GATEWAY_PORT=5432
GATEWAY_DATABASE_URL=postgresql+psycopg2://gateway_user:CHANGEME_GATEWAY_DB_PASSWORD_MIN32CHARS@postgres-gateway:5432/gateway_db

# --- Configuration Matrix Synapse ---
SYNAPSE_SERVER_NAME=sovereign.local
SYNAPSE_REPORT_STATS=no
# Clé partagée pour l'enregistrement administratif (HMAC SHA-256 ou hex 64 caractères)
SYNAPSE_REGISTRATION_SHARED_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Clés secrètes internes Synapse (minimum 32 octets aléatoires)
SYNAPSE_MACAROON_SECRET_KEY=CHANGEME_SYNAPSE_MACAROON_SECRET_MIN32CHARS
SYNAPSE_FORM_SECRET=CHANGEME_SYNAPSE_FORM_SECRET_MIN32CHARS
# URL interne du serveur Synapse (joignable uniquement par la passerelle via le réseau Docker)
SYNAPSE_INTERNAL_URL=http://synapse:8008

# --- Compte Administrateur Synapse dédié à la Passerelle ---
# Seul ce compte technique dispose d'un mot de passe fort côté Synapse.
# Tous les agents créés ensuite le sont sans mot de passe utilisable.
SYNAPSE_ADMIN_USERNAME=sovereign_gateway_admin
SYNAPSE_ADMIN_PASSWORD=CHANGEME_STRONG_RANDOM_ADMIN_PASSWORD_MIN24CHARS!
# Le jeton d'accès Matrix de l'administrateur est obtenu automatiquement
# par scripts/bootstrap_admin via connexion interne et stocké hors Git.
SYNAPSE_ADMIN_TOKEN=

# --- Passerelle d'Identité (Gateway FastAPI) ---
# Clé secrète pour signature PyJWT de session (minimum 32 octets aléatoires)
GATEWAY_JWT_SECRET_KEY=CHANGEME_JWT_SECRET_KEY_MIN32BYTES_HEX_0123456789abcdef0123456789abcdef
GATEWAY_JWT_ALGORITHM=HS256
GATEWAY_JWT_EXPIRE_MINUTES=15

# Clé Fernet pour le chiffrement symétrique du secret TOTP au repos
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_FERNET_KEY=CHANGEME_32BYTES_URLSAFE_BASE64_FERNET_KEY==

# Durcissement et limitation de débit
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCK_FAILED_ATTEMPTS=5
