# SovereignMsg - .gitignore
# Règle de sécurité : AUCUN secret, clé, certificat, ou donnée en clair dans Git.

# --- Secrets et Environnement ---
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
*.env.staging

# --- Certificats et Clés Cryptographiques ---
*.pem
*.key
*.crt
*.cer
*.csr
*.pfx
*.p12
*.der
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
deploy/synapse/*.signing.key
deploy/synapse/signing.key
deploy/synapse/data/
synapse-data/
.synapse_admin_token

# --- Volumes Docker et Données Locales ---
data/
volumes/
pg_data*/
docker-volumes/
*.sqlite
*.sqlite3
*.db

# --- Passerelle Python (FastAPI / SQLAlchemy) ---
gateway/__pycache__/
gateway/*/__pycache__/
gateway/*/*/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# --- Client PWA (React + Vite + TypeScript) ---
client/node_modules/
client/dist/
client/dist-ssr/
*.tsbuildinfo
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- IDE et Système d'exploitation ---
.idea/
.vscode/
.codebuddy/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
