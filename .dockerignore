# SovereignMsg - .dockerignore
.git
.github
.idea
.vscode
.codebuddy
client/node_modules
node_modules
client/dist
dist
*.log
.env
.env.*
!.env.example
# Les certificats TLS sont nécessaires au build Nginx - on les inclut via volume au runtime.
# On exclut uniquement les fichiers de clés hors du dossier certs/ connu.
*.pem
deploy/synapse/data
*.sqlite
*.sqlite3
__pycache__
*.pyc
.pytest_cache
.coverage
htmlcov
.venv
venv
docs/

